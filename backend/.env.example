# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# da SUA conta Grafana Cloud. Veja observability/README.md para o passo a passo
# de onde encontrar cada um. NUNCA commite o arquivo .env de verdade.

# URL de "remote_write" das métricas (Prometheus). Ex: https://prometheus-prod-XX-xxxx.grafana.net/api/prom/push
GC_PROMETHEUS_URL=https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push

# Username/Instance ID do Prometheus (número, ex: 123456)
GC_PROMETHEUS_USER=3554352

# URL de push dos logs (Loki). Ex: https://logs-prod-XXX.grafana.net/loki/api/v1/push
GC_LOKI_URL=https://logs-prod-024.grafana.net/loki/api/v1/push

# Username/Instance ID do Loki (número, ex: 654321)
GC_LOKI_USER=1772851

# Token de acesso (Access Policy Token) com escopos metrics:write e logs:write.
# É o mesmo token usado como senha tanto pro Prometheus quanto pro Loki.
GC_API_KEY=
